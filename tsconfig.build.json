{
  // Emits the published ESM build into dist/: one .js + .d.ts per source file, mirroring
  // src/ so the Go-parallel layout survives into the package.
  //
  // No source maps. The sources are not published, so a map could only point at files that
  // are not there (debuggers then show nothing, and Vite warns about every one), or carry the
  // sources inside it (`inlineSources`), which would add the whole of src/ to every install.
  // The JavaScript is the TypeScript with its types erased (`erasableSyntaxOnly`), comments
  // and line structure kept, so a stack trace into dist/ reads as the source does.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "resolveJsonModule": false
  },
  "include": ["src"],
  "exclude": ["src/**/*_test.ts", "src/**/testing/**", "src/testonly/fixtures.ts", "src/vendor/merkle/testonly/**"]
}
