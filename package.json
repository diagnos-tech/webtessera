{
  "name": "webtessera",
  "version": "0.1.0",
  "description": "A faithful TypeScript port of Tessera, the tile-based transparency log, for browsers, edge runtimes and servers, with IndexedDB and SQLite storage.",
  "keywords": [
    "transparency-log",
    "tessera",
    "tlog-tiles",
    "c2sp",
    "merkle-tree",
    "certificate-transparency",
    "witness",
    "indexeddb",
    "sqlite"
  ],
  "license": "Apache-2.0 AND BSD-3-Clause",
  "author": "MedDeck",
  "homepage": "https://github.com/diagnos-tech/webtessera#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diagnos-tech/webtessera.git"
  },
  "bugs": {
    "url": "https://github.com/diagnos-tech/webtessera/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/server/browser_guard.js",
    "./dist/server/index.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "examples/*",
    "site"
  ],
  "files": [
    "dist",
    "!dist/**/*_test.*",
    "LICENSE",
    "LICENSES",
    "NOTICE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./api": "./dist/api/state.js",
    "./api/layout": "./dist/api/layout/index.js",
    "./client": "./dist/client/index.js",
    "./fsck": "./dist/fsck/index.js",
    "./ctonly": "./dist/ctonly/ct.js",
    "./merkle/rfc6962": "./dist/vendor/merkle/rfc6962/rfc6962.js",
    "./merkle/compact": "./dist/vendor/merkle/compact/index.js",
    "./merkle/proof": "./dist/vendor/merkle/proof/index.js",
    "./note": "./dist/vendor/note/note.js",
    "./formats/log": "./dist/vendor/formats/log/index.js",
    "./formats/proof": "./dist/vendor/formats/proof/index.js",
    "./storage/objectstore": "./dist/storage/objectstore/index.js",
    "./storage/memory": "./dist/storage/memory/index.js",
    "./storage/indexeddb": "./dist/storage/indexeddb/index.js",
    "./storage/sqlite": "./dist/storage/sqlite/index.js",
    "./http": "./dist/http/index.js",
    "./witness": "./dist/witness/index.js",
    "./mirror": "./dist/mirror/index.js",
    "./server": {
      "workerd": "./dist/server/index.js",
      "edge-light": "./dist/server/index.js",
      "react-native": "./dist/server/browser_guard.js",
      "browser": "./dist/server/browser_guard.js",
      "default": "./dist/server/index.js"
    },
    "./browser": "./dist/browser/index.js",
    "./testonly": "./dist/testonly/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.workers.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun run test:unit && bun run test:workers && bun run test:browser",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:services": "vitest run --config vitest.services.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "upstream": "bun scripts/fetch-upstream.mjs",
    "fixtures": "bun scripts/fetch-upstream.mjs && cd fixtures/gen && go run . -out ../data",
    "interop": "node scripts/interop.mjs",
    "test:parity": "node scripts/test-parity.mjs",
    "smoke": "bun run build && node scripts/smoke-runtimes.mjs && node scripts/smoke-sqlite.mjs",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "prepack": "bun run clean && bun run build",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261002.1",
    "@libsql/client": "0.18.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "aws4fetch": "1.0.20",
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
