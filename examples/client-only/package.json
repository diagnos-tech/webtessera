  },
  "devDependencies": {
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "webtessera": "*"
  },
