{
  "name": "webtessera-example-log-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A public transparency log server: POST /add and the tlog-tiles read API on any SQLite, from one source on Node, Bun and Deno.",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    "./app": "./src/log_server.ts"
  },
  "scripts": {
    "keygen": "node scripts/keygen.ts",
    "start:node": "node --env-file-if-exists=.env src/main.ts",
    "start:bun": "bun src/main.ts",
    "start:deno": "deno run --env-file --allow-net --allow-read --allow-write --allow-env src/main.ts",
    "verify": "node scripts/verify.ts",
    "smoke:node": "node scripts/smoke.ts",
    "smoke:bun": "bun scripts/smoke.ts",
    "smoke:deno": "deno run --allow-net --allow-read --allow-write --allow-env scripts/smoke.ts",
    "verify:go": "node scripts/verify_go.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "webtessera": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
