{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webtessera-transparency-log",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // No compatibility_flags: webtessera uses only web-standard APIs, so the Worker runs
  // without nodejs_compat.
  "durable_objects": {
    "bindings": [{ "name": "LOG", "class_name": "TransparencyLog" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TransparencyLog"] }]
  // LOG_PRIVATE_KEY, the checkpoint signing key, is a secret rather than a var: set it
  // with `wrangler secret put LOG_PRIVATE_KEY`, and locally in .dev.vars. See README.md.
}
