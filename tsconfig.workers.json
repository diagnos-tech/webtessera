{
  // Type-checks the code that only ever runs inside workerd: the `*_workers_test.ts` suites
  // and their test-only Worker. These need the Workers runtime types, which conflict with
  // the DOM lib used by tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["src/**/*_workers_test.ts", "src/storage/sqlite/testing/workers/**/*.ts"],
  "exclude": []
}
