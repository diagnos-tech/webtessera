# The endpoints and credentials of the services that `pnpm test:services` talks to. This file is
# the single source of truth: compose.yaml reads it, action.yml exports it to the job, and a
# developer can load it with `set -a; . .github/actions/services/services.env; set +a`.
#
# Nothing here is secret. The services are throwaway containers bound to the loopback
# interface. The URLs use 127.0.0.1 rather than localhost so that a resolver that prefers
# ::1 cannot miss the IPv4-only port mapping.
RQLITE_URL=http://127.0.0.1:4001
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=webtessera-test
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=webtessera
S3_SECRET_ACCESS_KEY=webtessera-secret
