{
  "name": "webtessera-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The webtessera website, generated from the library's own sources at build time and published to GitHub Pages.",
  "scripts": {
    "prebuild": "bun run --cwd .. build",
    "build": "astro build",
    "predev": "bun run --cwd .. build",
    "dev": "astro dev",
    "preview": "node scripts/serve.ts",
    "typecheck": "astro check",
    "smoke": "node scripts/smoke.ts",
    "ci": "bun run build && bun run typecheck && bun run smoke"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@types/node": "22.20.5",
    "astro": "7.3.6",
    "astro-og-canvas": "0.13.2",
    "canvaskit-wasm": "0.42.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "webtessera": "*"
  },
  "peerDependenciesMeta": {
    "webtessera": {
      "optional": true
    }
  }
}
