{
  // Type-checks the site with `astro check`: the pages and components, the build-time
  // extractors (src/data, src/lib), the browser code (src/demo, src/shared) and the scripts.
  // webtessera resolves to the built package, as it would for any application.
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true
  },
  "include": [".astro/types.d.ts", "src", "scripts", "astro.config.ts"],
  "exclude": ["dist"]
}
