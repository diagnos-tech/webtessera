// Tested code regions, as README.md embeds them, under one caption: the test file they are read
// from, linked at the build's commit to the lines of the first region, and the line numbers of
// each. Every region is one code block.

import { Code } from "astro:components";
import type { Snippet } from "../data/readme.ts";
import { github, type SiteConfig } from "../lib/url.ts";
import { list } from "../lib/words.ts";
import Figure from "./Figure.astro";

interface Props {
	snippets: readonly Snippet[];
	site: SiteConfig;
	root: string;
	/** imports adds the test file's imports of the names a region uses. */
	imports?: boolean;
}

const { snippets, site, root, imports = false } = Astro.props;
const [first] = snippets;
if (first === undefined || snippets.some((s) => s.file !== first.file)) {
	throw new Error("CodeSample shows one or more regions of the same file");
}
const ranges = snippets.map((s) => `${s.lines[0]}–${s.lines[1]}`);
const code = (s: Snippet) => (imports && s.imports !== "" ? `${s.imports}\n\n${s.code}` : s.code);
---

<Figure
	caption={first.file}
	href={github(site, root, first.file, `L${first.lines[0]}-L${first.lines[1]}`)}
	note={`lines ${list(ranges)}`}
	class="code"
>
	{snippets.map((s) => <Code code={code(s)} lang="ts" theme="css-variables" />)}
</Figure>
