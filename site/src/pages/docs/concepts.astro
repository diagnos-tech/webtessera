	.tree-scroll {
		overflow-x: auto;
		padding-top: 12px;
	}

	.tree-fig :global(svg) {
		display: block;
		width: 100%;
		min-width: 520px;
		height: auto;
		font-family: var(--mono);
		font-size: 13px;
	}

	.tree-fig :global(.edge) {
		stroke: var(--rule);
		stroke-width: 1.5;
	}

	.tree-fig :global(.edge.hot) {
		stroke: var(--verified);
	}

	.tree-fig :global(.n rect) {
		fill: var(--paper);
		stroke: var(--rule);
	}

	.tree-fig :global(.n.path rect) {
		stroke: var(--verified);
		stroke-width: 1.5;
	}

	.tree-fig :global(.n.proof rect) {
		stroke: var(--proof);
		stroke-width: 1.5;
	}

	.tree-fig :global(.n text) {
		text-anchor: middle;
		fill: var(--ink);
	}

	.tree-fig :global(.n.path text) {
		fill: var(--verified);
	}

	.tree-fig :global(.n.proof text) {
		fill: var(--proof);
	}

	.tree-fig :global(.idx) {
		text-anchor: middle;
		fill: var(--ink-2);
	}

	.tree-fig :global(.idx.on) {
		fill: var(--ink);
		font-weight: 600;
	}

	.tree-fig :global(.cap) {
		fill: var(--ink-2);
		font-family: var(--serif);
	}
</style>
