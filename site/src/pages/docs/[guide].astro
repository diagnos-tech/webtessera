// One page per guide in docs/guides, rendered from the repository's Markdown.

import { getCollection, render } from "astro:content";
import Doc from "../../layouts/Doc.astro";
import { inline, plainText } from "../../lib/markdown.ts";
import { docsSequence, meta, neighbours } from "../../lib/pages.ts";

export async function getStaticPaths() {
	const guides = await getCollection("guides");
	return guides.map((guide) => ({ params: { guide: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const sequence = await docsSequence();
const { prev, next } = neighbours(sequence, `docs/${guide.id}/`);
---

<Doc
	title={plainText(guide.data.title)}
	heading={inline(guide.data.title)}
	description={guide.data.description}
	headings={headings}
	source={guide.data.file}
	trail={[{ path: "docs/", title: meta.docs.title }]}
	prev={prev}
	next={next}
>
	{guide.data.lead !== "" && <p class="lead" slot="lead" set:html={guide.data.lead} />}
	<div class="prose"><Content /></div>
</Doc>
