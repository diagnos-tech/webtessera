// The home page, in three parts: what webtessera is and how to install it, a log running in the
// reader's tab, and two tested code samples with the ways onward. How a log works is the
// concepts page's subject, and the evidence the compatibility page's; both are linked from the
// last part. Every number and artefact is the build's; the copy around them is hand-written.

import "../styles/artefacts.css";
import "../styles/demo.css";
import "../styles/home.css";
import { getCollection } from "astro:content";
import CodeSample from "../components/CodeSample.astro";
import Demo from "../components/Demo.astro";
import GitHubMark from "../components/GitHubMark.astro";
import { snippet } from "../data/index.ts";
import Base from "../layouts/Base.astro";
import { meta } from "../lib/pages.ts";
import { getSiteData } from "../lib/site.ts";
import { href } from "../lib/url.ts";
import { capitalise, count, num } from "../lib/words.ts";

const d = await getSiteData();
const { site, pkg, install, sample, fixtures, evidence, examples, porting, root } = d;
const guides = await getCollection("guides");
const { description } = meta.home;
// The headline is set in two halves, at its comma.
const [opening = meta.home.headline, ...rest] = meta.home.headline.split(/(?<=,) /);
const jsonLd = [
	{
		"@type": "WebSite",
		"@id": `${site.url}#website`,
		name: pkg.name,
		url: site.url,
		description,
		inLanguage: "en",
		about: { "@id": `${site.url}#software` },
	},
	{
		"@type": "SoftwareSourceCode",
		"@id": `${site.url}#software`,
		name: pkg.name,
		description: pkg.description,
		url: site.url,
		codeRepository: site.repo,
		programmingLanguage: { "@type": "ComputerLanguage", name: "TypeScript", url: "https://www.typescriptlang.org/" },
		runtimePlatform: ["Node.js", "Deno", "Bun", "Web browsers", "Cloudflare Workers"],
		license: pkg.licenses.map((id) => `https://spdx.org/licenses/${id}.html`),
		version: pkg.version,
		keywords: pkg.keywords.join(", "),
		isAccessibleForFree: true,
		author: { "@type": "Organization", name: pkg.author },
		sameAs: [site.npm],
		isBasedOn: {
			"@type": "SoftwareSourceCode",
			name: "Tessera",
			url: `${porting.upstream}/tree/${porting.commit}`,
			codeRepository: porting.upstream,
			programmingLanguage: "Go",
			version: porting.commit,
			license: "https://spdx.org/licenses/Apache-2.0.html",
		},
		...(site.date === undefined ? {} : { dateModified: site.date }),
	},
];
const sentence = (s: string) => s.charAt(0).toLowerCase() + s.slice(1).replace(/\.?$/, ".");
---

<Base title={meta.home.title} description={description} jsonLd={jsonLd} type="website">
	{/* The install command is machine text at the top of the page, so its font is fetched early. */}
	<link
		slot="head"
		rel="preload"
		href={href("fonts/jetbrains-mono-latin-wght-normal.woff2")}
		as="font"
		type="font/woff2"
		crossorigin
	/>
	<noscript slot="head">
		<style>
			.js-only { display: none !important; }
			/* Without its form, the demo sets the verdict beside the entries. */
			@media (min-width: 62em) {
				.demo-body { grid-template-areas: "entries status" "entries proof" "note tiles"; grid-template-rows: auto 1fr auto; }
			}
		</style>
	</noscript>

	<section class="hero" aria-labelledby="title">
		<div class="wrap">
			<p class="eyebrow">
				<a href={site.npm}>v{pkg.version}</a>
				<span>open source, {pkg.licenses[0]}</span>
			</p>
			<h1 id="title">{opening} <span class="tint">{rest.join(" ")}</span></h1>
			<p class="lead">
				webtessera is {sentence(pkg.description)} Append an entry and get a receipt that anyone can verify offline.
			</p>
			<div class="install machine">
				<span class="prompt" aria-hidden="true">$</span>
				<code translate="no">{install.command}</code>
				<button type="button" class="copy js-only" data-copy={install.command}>Copy</button>
				<span class="visually-hidden" role="status" data-copy-status></span>
			</div>
			<p class="cta">
				<a class="btn primary" href={href("docs/")}>Read the docs</a>
				<a class="btn quiet" href={site.repo}><GitHubMark /> GitHub</a>
			</p>
			<p class="runs small">{install.runs}</p>
		</div>
	</section>

	<section class="section" aria-labelledby="demo">
		<div class="wrap">
			<div class="section-head">
				<p class="kicker">Live demo</p>
				<h2 id="demo">A log in this tab</h2>
				<p>
					This is webtessera running in your browser: a log in memory, signed by a key generated in this tab and
					seeded with the {num(sample.entries.length)} entries the page was built with. Add an entry and watch its
					leaf hash, the tile, the root hash and the signed checkpoint follow. Then change an entry: the log is
					append-only, so its proof stops verifying.
				</p>
			</div>
			<Demo sample={sample} origin={site.origin} />
		</div>
	</section>

	<section class="section" aria-labelledby="use">
		<div class="wrap">
			<div class="section-head">
				<p class="kicker">Use it</p>
				<h2 id="use">Open a log, append, verify</h2>
				<p>
					<code>append()</code> resolves once a signed checkpoint covers the entry, and returns a receipt that
					anyone with the log’s public key can check offline.
				</p>
			</div>
			<div class="samples">
				<div>
					<h3>On a server, with any SQLite</h3>
					<CodeSample snippets={[snippet(d, "safe_imports"), snippet(d, "safe_server_example")]} site={site} root={root} />
				</div>
				<div>
					<h3>In a browser, with IndexedDB and a key that never leaves the device</h3>
					<CodeSample snippets={[snippet(d, "safe_browser_example")]} site={site} root={root} imports />
				</div>
			</div>
			<p class="after-samples">
				Both samples are regions of the test suite, and run in CI.
				<a href={href("docs/safe-api/")}>The safe API guide</a> explains each default;
				<a href={href("docs/ported-api/")}>the ported API</a> is Tessera’s own, name for name.
			</p>
			<ul class="onward">
				<li>
					<a href={href("docs/concepts/")}>How a log works</a>
					<p>
						Leaves, tiles, checkpoints, proofs, receipts and witnesses, each beside an artefact of a log this site
						built.
					</p>
				</li>
				<li>
					<a href={href("docs/")}>Documentation</a>
					<p>
						{capitalise(count(guides.length, "guide"))}, from the safe API to one per use case, and a reference for all
						{num(d.entryPoints.length)} entry points.
					</p>
				</li>
				<li>
					<a href={href("examples/")}>Examples</a>
					<p>{capitalise(count(examples.length, "runnable application"))}, one per use case, each with its own tests.</p>
				</li>
				<li>
					<a href={href("compatibility/")}>Compatibility with Tessera</a>
					<p>
						Its logs are byte for byte Tessera’s: {count(fixtures.files.length, "golden fixture file")},
						{count(evidence.golden.length, "storage backend")} and {evidence.differentialRecords.toLocaleString("en-GB")}
						differential records check it on every change.
					</p>
				</li>
			</ul>
		</div>
	</section>
</Base>

<script>
	// The home page's only script. It copies the install command, and it loads the live demo
	// when the demo nears the viewport, or as soon as the reader points at it or tabs into it.
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
		const status = button.parentElement?.querySelector("[data-copy-status]");
		button.addEventListener("click", () => {
			navigator.clipboard.writeText(button.dataset.copy ?? "").then(
				() => {
					button.textContent = "Copied";
					button.dataset.copied = "";
					if (status) {
						status.textContent = "Copied to the clipboard.";
					}
					setTimeout(() => {
						button.textContent = "Copy";
						delete button.dataset.copied;
						if (status) {
							status.textContent = "";
						}
					}, 2000);
				},
				() => {
					// Without clipboard access, select the command for the reader to copy.
					const code = button.parentElement?.querySelector("code");
					if (code) {
						getSelection()?.selectAllChildren(code);
					}
				},
			);
		});
	}

	const root = document.querySelector<HTMLElement>("[data-demo]");
	if (root !== null) {
		let started = false;
		const observer = new IntersectionObserver(
			(entries) => {
				if (entries.some((e) => e.isIntersecting)) {
					start();
				}
			},
			{ rootMargin: "320px 0px" },
		);
		const start = () => {
			if (started) {
				return;
			}
			started = true;
			observer.disconnect();
			import("../demo/main.ts")
				.then((demo) => demo.start(root))
				.catch((err: unknown) => {
					const status = root.querySelector<HTMLElement>("[data-demo-status]");
					const title = root.querySelector("[data-demo-status-title]");
					const detail = root.querySelector("[data-demo-status-detail]");
					if (status !== null && title !== null && detail !== null) {
						status.dataset.state = "error";
						title.textContent = "The live log could not start";
						detail.textContent = String(err);
					}
				});
		};
		observer.observe(root);
		root.addEventListener("pointerenter", start, { once: true });
		root.addEventListener("focusin", start, { once: true });
	}
</script>
